# Server side (Netlify environment variables — never commit real values)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Client side (public, baked into the build). The practice customer's ElevenLabs
# agent is a PUBLIC agent with prompt/voice overrides enabled, so no ElevenLabs
# key is needed at runtime.
VITE_ELEVENLABS_AGENT_ID=
